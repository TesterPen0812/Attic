diff --git a/AtticTests/DailyCleanupServiceTests.swift b/AtticTests/DailyCleanupServiceTests.swift
index 6d0f6ca..369ea82 100644
--- a/AtticTests/DailyCleanupServiceTests.swift
+++ b/AtticTests/DailyCleanupServiceTests.swift
@@ -127,4 +127,25 @@ final class DailyCleanupServiceTests: XCTestCase {
         XCTAssertEqual(service.performCleanup(), 0)
         XCTAssertEqual(try context.fetchCount(FetchDescriptor<TaskItem>()), 2)
     }
+    @MainActor
+    func testAutomaticCleanupDoesNotDeleteFromStaleStateWhenRefreshFails() throws {
+        let now = Date(timeIntervalSince1970: 500_000)
+        let old = now.addingTimeInterval(-3 * 24 * 60 * 60)
+        let clock = MutableNow(old)
+        let store = try makeTestStore(now: { clock.value })
+        let task = try XCTUnwrap(store.create(title: "Needs fresh state"))
+        XCTAssertTrue(store.markDone(task))
+        clock.value = now
+
+        let service = DailyCleanupService(
+            store: store,
+            now: { now },
+            refreshStore: { false }
+        )
+        service.start()
+        defer { service.stop() }
+
+        XCTAssertTrue(store.tasks.contains { $0.id == task.id })
+    }
+
+}
+diff --git a/AtticTests/PersistenceControllerTests.swift b/AtticTests/PersistenceControllerTests.swift
+new file mode 100644
+index 0000000..264f35f
+--- /dev/null
++++ b/AtticTests/PersistenceControllerTests.swift
+@@ -0,0 +1,54 @@
++import Foundation
++import SwiftData
++import XCTest
++@testable import Attic
++
++final class PersistenceControllerTests: XCTestCase {
++    func testBackupRemainsPendingWhenStoreDoesNotExistYet() throws {
++        let fileManager = FileManager.default
++        let directory = fileManager.temporaryDirectory
++            .appendingPathComponent("AtticBackupTests-\(UUID().uuidString)", isDirectory: true)
++        try fileManager.createDirectory(at: directory, withIntermediateDirectories: true)
++        defer { try? fileManager.removeItem(at: directory) }
++
++        let suiteName = "AtticTests.PersistenceBackup.\(UUID().uuidString)"
++        let defaults = try XCTUnwrap(UserDefaults(suiteName: suiteName))
++        defer { defaults.removePersistentDomain(forName: suiteName) }
++
++        let storeURL = directory.appendingPathComponent("fallback.store")
++        let configuration = ModelConfiguration(
++            "backup-test",
++            url: storeURL,
++            cloudKitDatabase: .none
++        )
++
++        try PersistenceController.createPreCloudKitBackupIfNeeded(
++            for: configuration,
++            defaults: defaults,
++            fileManager: fileManager
++        )
++
++        try Data("database".utf8).write(to: storeURL)
++        try Data("wal".utf8).write(to: URL(fileURLWithPath: storeURL.path + "-wal"))
++        try Data("shm".utf8).write(to: URL(fileURLWithPath: storeURL.path + "-shm"))
++
++        try PersistenceController.createPreCloudKitBackupIfNeeded(
++            for: configuration,
++            defaults: defaults,
++            fileManager: fileManager
++        )
++
++        XCTAssertEqual(
++            try Data(contentsOf: URL(fileURLWithPath: storeURL.path + ".pre-cloudkit")),
++            Data("database".utf8)
++        )
++        XCTAssertEqual(
++            try Data(contentsOf: URL(fileURLWithPath: storeURL.path + ".pre-cloudkit-wal")),
++            Data("wal".utf8)
++        )
++        XCTAssertEqual(
++            try Data(contentsOf: URL(fileURLWithPath: storeURL.path + ".pre-cloudkit-shm")),
++            Data("shm".utf8)
++        )
++    }
++}
